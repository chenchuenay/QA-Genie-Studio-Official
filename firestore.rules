rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection – only owner
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Usage collection – only owner
    match /usage/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Analytics – read only, no client writes
    match /analytics/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    // Issue reports – authenticated users can create, only owner can read/update/delete
    match /issue_reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
    // Cloud-function-only collections – deny all client access
    match /guests/{doc} { allow read, write: if false; }
    match /deviceUsage/{doc} { allow read, write: if false; }
    match /deviceGuestMapping/{doc} { allow read, write: if false; }
    match /emailCooldown/{doc} { allow read, write: if false; }
    match /the_qag_registry/{doc} { allow read, write: if false; }
    match /processed_requests/{doc} { allow read, write: if false; }
    // User synced suites – only owner
    match /userSuites/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /suites/{suiteId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }
    }
    // Member profiles – owner by uid field or email doc ID
    match /memberProfiles/{email} {
      allow read: if request.auth != null && (
        request.auth.uid == resource.data.uid ||
        request.auth.token.email == email
      );
      allow write: if false;
    }
    // Member data (suites, sessions) – owner by uid in path
    match /memberData/{tier}/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    // User session (active device tracking) – only owner
    match /userSessions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}