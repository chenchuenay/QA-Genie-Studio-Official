{
  "name": "qa-genie-functions",
  "description": "Cloud Functions for QA Genie",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:prod": "firebase deploy --project qa-genie-ai --only functions",
    "deploy:dev": "firebase deploy --project qa-genie-ai-dev --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.1.0",
    "node-fetch": "^2.7.0"
  },
  "private": true
}
